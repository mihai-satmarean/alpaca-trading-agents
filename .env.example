# Alpaca Paper Trading (contest / production paper account)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_API_ENDPOINT=https://paper-api.alpaca.markets

# Isolated staging paper account (laptop tests). Used only when ALPACA_ENV=staging
# or when you run scripts/run_staging.sh. Never commit real values.
# ALPACA_ENV=production
# ALPACA_STAGING_API_KEY=
# ALPACA_STAGING_SECRET_KEY=
# NTFY_TOPIC=alpaca-hackathon-staging-mihai

# Dell4 LLM Cluster (contest / Frank's EC2). Laptop staging overrides this
# to k3s LiteLLM in scripts/run_staging.sh — do not point this at k3s here.
OPENAI_BASE_URL=http://100.69.81.102:4000/v1
OPENAI_API_KEY=your_litellm_virtual_key_here
# Optional laptop override (default is Tailscale pillar5 NodePort):
# OPENAI_STAGING_BASE_URL=http://100.101.239.56:30400/v1

# AI model overrides (defaults to dell4-finance / dell4-chat)
# NARRATOR_MODEL=dell4-chat
# NARRATOR_MAX_TOKENS=4000
# COUNCIL_TIMEOUT=60
# COUNCIL_THINKING_TIMEOUT=120
# COUNCIL_THINKING_MAX_TOKENS=8000
# FINANCE_ADVISOR_TIMEOUT=30
